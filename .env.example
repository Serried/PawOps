POSTGRES_DB=pawops
POSTGRES_USER=pawops
POSTGRES_PASSWORD=pawops_dev_password
# Change together with DATABASE_URL if 5432 is in use
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pawops:pawops_dev_password@localhost:5432/pawops
API_PORT=3001
WEB_PORT=8080
APP_TIMEZONE=Asia/Bangkok

ALLOW_DEMO_SEED=false
SEED_PASSWORD=

DUPLICATE_WINDOW_MINUTES=30
OVERDUE_GRACE_MINUTES=15
RABBITMQ_URL=amqp://guest:guest@localhost:5672
ALERT_RETRY_DELAY_MS=60000
ALERT_MAX_ATTEMPTS=5
UPLOAD_DIR=uploads
# Optional: separate test database
# TEST_DATABASE_URL=postgresql://pawops:pawops_dev_password@localhost:5432/pawops
