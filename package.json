{
  "name": "pawops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "start": "node server/index.js",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "node server/migrate.js",
    "db:seed": "node server/seed-dev.js",
    "build": "vite build",
    "lint": "eslint .",
    "test": "npm run test:auth && vitest run",
    "test:auth": "node --test server/passwords.test.js server/auth.test.js server/households.test.js server/invites.test.js",
    "test:unit": "vitest run --config vitest.unit.config.js",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.13.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
